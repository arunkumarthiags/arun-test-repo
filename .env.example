DATABASE_URL=postgresql+psycopg://gauntlet:gauntlet@postgres:5432/gauntlet
REDIS_URL=redis://redis:6379/0
GAUNTLET_ENV=dev

# Layer 2 — judge model (per-agent override planned)
JUDGE_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# Layer 3 — cluster trigger threshold
CLUSTER_FAILURE_THRESHOLD_7D=3

# Layer 6 — drift
DRIFT_SAMPLE_RATE=0.05
DRIFT_ALERT_THRESHOLD_PCT=10.0
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
DRIFT_WEBHOOK_URL=
