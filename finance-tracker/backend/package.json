{
  "name": "finance-tracker-backend",
  "version": "1.0.0",
  "description": "Backend API for personal finance tracker with Plaid integration",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:setup": "ts-node src/utils/setupDatabase.ts",
    "db:seed": "ts-node src/utils/seedData.ts"
  },
  "keywords": ["finance", "plaid", "api"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "plaid": "^19.0.0",
    "better-sqlite3": "^9.2.2",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "multer": "^1.4.5-lts.1",
    "crypto": "^1.0.1",
    "csv-stringify": "^6.4.5",
    "date-fns": "^3.0.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/multer": "^1.4.11",
    "typescript": "^5.3.3",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2"
  }
