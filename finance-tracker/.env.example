# Plaid API Configuration
# Sign up at https://dashboard.plaid.com/signup
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox
# For production, use: production
# For development with live credentials, use: development

# Application Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_PATH=./data/finance.db

# Encryption key for storing sensitive data (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=your_32_byte_encryption_key_here

# Webhook URL (optional - for receiving transaction updates from Plaid)
# WEBHOOK_URL=https://yourdomain.com/api/plaid/webhook
