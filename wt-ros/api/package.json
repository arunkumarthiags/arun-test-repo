{
  "name": "@wt-ros/api",
  "version": "1.0.0",
  "description": "WT-ROS GraphQL API with TypeORM and TypeGraphQL",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/config/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/config/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/data-source.ts",
    "db:seed": "psql $DATABASE_URL -f ../scripts/seed-data.sql"
  },
  "dependencies": {
    "@types/graphql-type-json": "^0.3.5",
    "@wt-ros/common": "*",
    "apollo-server-express": "^3.13.0",
    "class-validator": "^0.14.1",
    "dataloader": "^2.2.2",
    "express": "^4.18.2",
    "graphql": "^16.8.1",
    "graphql-type-json": "^0.3.2",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "type-graphql": "^2.0.0-rc.1",
    "typedi": "^0.10.0",
    "typeorm": "^0.3.19",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
