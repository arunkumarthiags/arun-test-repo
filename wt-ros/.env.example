# WT-ROS Environment Variables

# Database
DATABASE_URL=postgresql://wt_ros:local_dev@localhost:5432/wt_ros

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=4000
NODE_ENV=development

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token  # For socket mode

# GitHub Integration
GITHUB_TOKEN=ghp_your-github-token
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Google Integration (for Docs)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# Jira Integration
JIRA_HOST=https://your-company.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-api-token

# AI/LLM
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Auth (Aserto/Topaz)
ASERTO_TENANT_ID=your-tenant-id
ASERTO_API_KEY=your-api-key
ASERTO_AUTHORIZER_URL=https://authorizer.prod.aserto.com

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql
NEXT_PUBLIC_WS_URL=ws://localhost:4000/graphql
