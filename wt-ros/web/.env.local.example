# WT-ROS Web Environment Variables
# Copy this file to .env.local and update the values

# API Configuration
# The base URL for the GraphQL API server (without /graphql suffix)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: MUI X License Key (only needed for premium features)
# NEXT_PUBLIC_MUI_X_LICENSE_KEY=your-license-key-here
