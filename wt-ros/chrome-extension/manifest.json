{
  "manifest_version": 3,
  "name": "WT-ROS Work Tracker",
  "version": "1.0.0",
  "description": "Link web pages to work items in WT-ROS for automatic activity tracking",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://*.atlassian.net/*",
    "https://*.jira.com/*",
    "https://github.com/*",
    "https://*.slack.com/*",
    "https://docs.google.com/*",
    "https://*.confluence.com/*",
    "https://*.figma.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.atlassian.net/*",
        "https://*.jira.com/*",
        "https://github.com/*",
        "https://*.slack.com/*",
        "https://docs.google.com/*",
        "https://*.confluence.com/*",
        "https://*.figma.com/*"
      ],
      "js": ["dist/content.js"],
      "css": ["dist/content.css"]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "32": "public/icons/icon32.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    },
    "default_title": "WT-ROS Work Tracker"
  },
  "icons": {
    "16": "public/icons/icon16.png",
    "32": "public/icons/icon32.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "options_page": "src/popup/popup.html"
}
